{
  "name": "oniro-app-ide",
  "displayName": "Oniro App IDE",
  "description": "Lightweight IDE for Oniro/OpenHarmony and HarmonyOS app development: build, sign, run on device or emulator, ArkTS checks, tests, crash analysis, logs and SDK management.",
  "version": "0.7.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/eclipse-oniro4openharmony/oniro-vscode-ext.git"
  },
  "publisher": "oniro",
  "author": "Francesco Pham <francesco.pham1@h-partners.com>",
  "license": "Apache-2.0",
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Testing",
    "Other"
  ],
  "activationEvents": [
    "workspaceContains:build-profile.json5",
    "onView:oniroMainView",
    "onLanguage:ets"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "oniro-ide.runAll",
        "title": "Run (Build, Install, Launch)",
        "category": "Oniro",
        "icon": "$(play)"
      },
      {
        "command": "oniro-ide.quickBuild",
        "title": "Build",
        "category": "Oniro",
        "icon": "$(package)"
      },
      {
        "command": "oniro-ide.build",
        "title": "Build…",
        "category": "Oniro"
      },
      {
        "command": "oniro-ide.sign",
        "title": "Sign Project",
        "category": "Oniro",
        "icon": "$(key)"
      },
      {
        "command": "oniro-ide.signHap",
        "title": "Sign HAP…",
        "category": "Oniro"
      },
      {
        "command": "oniro-ide.verifyHap",
        "title": "Verify HAP Signature…",
        "category": "Oniro"
      },
      {
        "command": "oniro-ide.harmonyosLogin",
        "title": "Sign In to Huawei Developer Account",
        "category": "Oniro"
      },
      {
        "command": "oniro-ide.harmonyosLogout",
        "title": "Sign Out of Huawei Developer Account",
        "category": "Oniro"
      },
      {
        "command": "oniro-ide.checkArkts",
        "title": "Check ArkTS",
        "category": "Oniro",
        "icon": "$(checklist)"
      },
      {
        "command": "oniro-ide.fixArkts",
        "title": "Fix ArkTS Problems",
        "category": "Oniro"
      },
      {
        "command": "oniro-ide.startEmulator",
        "title": "Start Emulator",
        "category": "Oniro",
        "icon": "$(vm-running)"
      },
      {
        "command": "oniro-ide.stopEmulator",
        "title": "Stop Emulator",
        "category": "Oniro",
        "icon": "$(vm-outline)"
      },
      {
        "command": "oniro-ide.connectEmulator",
        "title": "Connect Emulator",
        "category": "Oniro"
      },
      {
        "command": "oniro-ide.selectDevice",
        "title": "Select Target Device",
        "category": "Oniro",
        "icon": "$(device-mobile)"
      },
      {
        "command": "oniro-ide.installApp",
        "title": "Install App",
        "category": "Oniro"
      },
      {
        "command": "oniro-ide.launchApp",
        "title": "Launch App",
        "category": "Oniro",
        "icon": "$(rocket)"
      },
      {
        "command": "oniro-ide.stopApp",
        "title": "Stop App",
        "category": "Oniro",
        "icon": "$(debug-stop)"
      },
      {
        "command": "oniro-ide.uninstallApp",
        "title": "Uninstall App",
        "category": "Oniro"
      },
      {
        "command": "oniro-ide.screenshot",
        "title": "Take Device Screenshot",
        "category": "Oniro",
        "icon": "$(device-camera)"
      },
      {
        "command": "oniro-ide.showLastCrash",
        "title": "Show Last Crash",
        "category": "Oniro",
        "icon": "$(bug)"
      },
      {
        "command": "oniro-ide.createProject",
        "title": "Create Project",
        "category": "Oniro"
      },
      {
        "command": "oniro-ide.openSdkManager",
        "title": "Open SDK Manager",
        "category": "Oniro",
        "icon": "$(library)"
      },
      {
        "command": "oniro-ide.showHilogViewer",
        "title": "Show HiLog Viewer",
        "category": "Oniro",
        "icon": "$(output)"
      },
      {
        "command": "oniro-ide.runDoctor",
        "title": "Run Doctor",
        "category": "Oniro",
        "icon": "$(heart)"
      },
      {
        "command": "oniro-ide.searchApi",
        "title": "Search SDK API",
        "category": "Oniro",
        "icon": "$(symbol-method)"
      },
      {
        "command": "oniro-ide.searchDocs",
        "title": "Search OpenHarmony Docs",
        "category": "Oniro",
        "icon": "$(book)"
      },
      {
        "command": "oniro-ide.syncDocs",
        "title": "Download/Update OpenHarmony Docs",
        "category": "Oniro"
      },
      {
        "command": "oniro-ide.refreshTreeView",
        "title": "Refresh",
        "category": "Oniro",
        "icon": "$(refresh)"
      },
      {
        "command": "oniro-ide.showLog",
        "title": "Show Log",
        "category": "Oniro",
        "icon": "$(output)"
      }
    ],
    "taskDefinitions": [
      {
        "type": "oniro",
        "required": [
          "command"
        ],
        "properties": {
          "command": {
            "type": "string",
            "enum": [
              "build",
              "checkArkts"
            ],
            "description": "What to run: `build` (hvigor through Oniro, errors to the Problems panel) or `checkArkts`."
          },
          "product": {
            "type": "string",
            "description": "hvigor product to build (build only)."
          },
          "module": {
            "type": "string",
            "description": "Module to build (build only)."
          },
          "buildMode": {
            "type": "string",
            "description": "hvigor build mode, e.g. debug or release (build only)."
          }
        }
      }
    ],
    "debuggers": [
      {
        "type": "oniro-debug",
        "label": "Oniro: Run on Device",
        "configurationAttributes": {
          "launch": {
            "properties": {}
          }
        },
        "initialConfigurations": [
          {
            "name": "Run Oniro App",
            "type": "oniro-debug",
            "request": "launch"
          }
        ],
        "configurationSnippets": [
          {
            "label": "Oniro: Run on Device",
            "body": {
              "name": "Run Oniro App",
              "type": "oniro-debug",
              "request": "launch"
            }
          }
        ]
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "oniro-sidebar",
          "title": "Oniro",
          "icon": "media/oniro-icon.svg"
        }
      ]
    },
    "views": {
      "oniro-sidebar": [
        {
          "id": "oniroMainView",
          "name": "Oniro Tools",
          "icon": "media/oniro-icon.svg"
        }
      ]
    },
    "configuration": {
      "type": "object",
      "title": "Oniro",
      "properties": {
        "oniro.sdkRootDir": {
          "type": "string",
          "default": "${userHome}/setup-ohos-sdk",
          "description": "Root directory where OpenHarmony SDKs are installed."
        },
        "oniro.cmdToolsPath": {
          "type": "string",
          "default": "${userHome}/command-line-tools",
          "description": "Directory where OpenHarmony command-line tools are installed."
        },
        "oniro.cmdToolsUrlLinux": {
          "type": "string",
          "default": "",
          "description": "Download URL for the command-line tools on Linux. Leave empty for the Oniro default (the public 5.1.0 OpenHarmony build)."
        },
        "oniro.cmdToolsUrlWindows": {
          "type": "string",
          "default": "",
          "description": "Download URL for OpenHarmony command-line tools on Windows."
        },
        "oniro.cmdToolsUrlMac": {
          "type": "string",
          "default": "",
          "description": "Download URL for OpenHarmony command-line tools on macOS."
        },
        "oniro.emulatorDir": {
          "type": "string",
          "default": "${userHome}/oniro-emulator",
          "description": "Directory where Oniro emulator is installed."
        },
        "oniro.emulatorUrl": {
          "type": "string",
          "default": "",
          "description": "Download URL for the Oniro emulator archive. Leave empty to get the latest release for this machine: arm64 on Apple Silicon and arm64 Linux, x86_64 elsewhere."
        },
        "oniro.hapPath": {
          "type": "string",
          "default": "",
          "description": "HAP to install, relative to the project folder. Leave empty to install what the last build produced (the signed HAP of the entry module, else the newest built HAP)."
        },
        "oniro.tmpDir": {
          "type": "string",
          "default": "",
          "description": "Directory used for temporary files while downloading and extracting the SDK, command-line tools, and emulator. Leave empty to use a .oniro-tmp folder next to the install target. Set this when that filesystem is short on space, for example when the install target lives on a small partition."
        },
        "oniro.hdcPath": {
          "type": "string",
          "default": "",
          "description": "hdc binary to use. Leave empty to use the one in the command-line tools or the SDK."
        },
        "oniro.harmonyosSdkPath": {
          "type": "string",
          "default": "",
          "description": "HarmonyOS SDK (a DevEco Studio or command-line-tools install root, or its `sdk` folder). Leave empty to find DevEco Studio or HarmonyOS command-line tools automatically."
        },
        "oniro.sdkUrlBase": {
          "type": "string",
          "default": "",
          "description": "Base URL of the OpenHarmony SDK mirror. Leave empty for the Huawei Cloud mirror."
        },
        "oniro.docsDir": {
          "type": "string",
          "default": "",
          "description": "Where the OpenHarmony docs are downloaded for Search Docs. Leave empty for `<sdkRootDir>/docs`."
        },
        "oniro.emulatorBootTimeout": {
          "type": "number",
          "default": 240,
          "minimum": 10,
          "description": "Seconds to wait for the emulator to finish booting before giving up."
        },
        "oniro.checkArktsOnSave": {
          "type": "boolean",
          "default": false,
          "description": "Run the ArkTS checker on each saved .ets file and show its findings in the Problems panel."
        },
        "oniro.openHilogOnLaunch": {
          "type": "boolean",
          "default": true,
          "description": "Open the HiLog viewer on the app process after launching it."
        },
        "ets.linterVersion": {
          "type": "string",
          "description": "The version of the ArkTS linter to use. Set to 'off' to disable the linter.",
          "enum": [
            "1.0",
            "1.1",
            "off"
          ],
          "default": "1.1"
        }
      }
    },
    "languages": [
      {
        "id": "ets",
        "extensions": [
          ".ets",
          ".d.ets"
        ],
        "aliases": [
          "ArkTS",
          "ets"
        ],
        "configuration": "./language/language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "ets",
        "scopeName": "source.ets",
        "path": "./syntaxes/ets.tmLanguage.json"
      }
    ],
    "jsonValidation": [
      {
        "fileMatch": "code-linter.json5",
        "url": "./schemas/code-linter.schema.json"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "oniro-ide.build",
          "when": "oniro.isProject"
        },
        {
          "command": "oniro-ide.checkArkts",
          "when": "oniro.isProject"
        },
        {
          "command": "oniro-ide.fixArkts",
          "when": "oniro.isProject"
        },
        {
          "command": "oniro-ide.installApp",
          "when": "oniro.isProject"
        },
        {
          "command": "oniro-ide.launchApp",
          "when": "oniro.isProject"
        },
        {
          "command": "oniro-ide.quickBuild",
          "when": "oniro.isProject"
        },
        {
          "command": "oniro-ide.runAll",
          "when": "oniro.isProject"
        },
        {
          "command": "oniro-ide.showLastCrash",
          "when": "oniro.isProject"
        },
        {
          "command": "oniro-ide.sign",
          "when": "oniro.isProject"
        },
        {
          "command": "oniro-ide.stopApp",
          "when": "oniro.isProject"
        },
        {
          "command": "oniro-ide.uninstallApp",
          "when": "oniro.isProject"
        },
        {
          "command": "oniro-ide.refreshTreeView",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "oniro-ide.runAll",
          "when": "view == oniroMainView && oniro.isProject",
          "group": "navigation@1"
        },
        {
          "command": "oniro-ide.selectDevice",
          "when": "view == oniroMainView",
          "group": "navigation@2"
        },
        {
          "command": "oniro-ide.refreshTreeView",
          "when": "view == oniroMainView",
          "group": "navigation@3"
        },
        {
          "command": "oniro-ide.runDoctor",
          "when": "view == oniroMainView",
          "group": "more@1"
        },
        {
          "command": "oniro-ide.showLog",
          "when": "view == oniroMainView",
          "group": "more@2"
        }
      ],
      "explorer/context": [
        {
          "command": "oniro-ide.signHap",
          "when": "resourceExtname == .hap",
          "group": "oniro@1"
        },
        {
          "command": "oniro-ide.verifyHap",
          "when": "resourceExtname == .hap",
          "group": "oniro@2"
        }
      ],
      "editor/context": [
        {
          "command": "oniro-ide.searchApi",
          "when": "editorLangId == ets",
          "group": "oniro@1"
        },
        {
          "command": "oniro-ide.searchDocs",
          "when": "editorLangId == ets",
          "group": "oniro@2"
        }
      ],
      "editor/title": [
        {
          "command": "oniro-ide.runAll",
          "when": "editorLangId == ets && oniro.isProject",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "oniro-ide.runAll",
        "key": "ctrl+f5",
        "mac": "cmd+f5",
        "when": "oniro.isProject && !inDebugMode"
      }
    ],
    "viewsWelcome": [
      {
        "view": "oniroMainView",
        "contents": "Open an OpenHarmony project, or create one.\n[Create Project](command:oniro-ide.createProject)\n[Open SDK Manager](command:oniro-ide.openSdkManager)"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./ && npm run copy-resources",
    "copy-resources": "cp -r src/*.html out/ 2>/dev/null || cp src\\*.html out\\ 2>nul || true",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test --label unit",
    "package": "vsce package",
    "publish:vscode": "vsce publish",
    "publish:openvsx": "ovsx publish",
    "test:integration": "node scripts/create-fixture.cjs && vscode-test --label integration"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/vscode": "^1.100.0",
    "@typescript-eslint/eslint-plugin": "^8.31.1",
    "@typescript-eslint/parser": "^8.31.1",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.2.1",
    "eslint": "^9.25.1",
    "ovsx": "^0.10.1",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@arkts/language-plugin": "^1.3.10",
    "@arkts/language-server": "^1.3.10",
    "@arkts/language-service": "^1.3.9",
    "@oniroproject/core": "^0.19.0",
    "vscode-languageclient": "^9.0.1"
  },
  "keywords": [
    "oniro",
    "openharmony",
    "harmonyos",
    "arkts",
    "ets",
    "hvigor",
    "hdc"
  ]
}
